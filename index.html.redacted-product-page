<script>
  // ===== Live AI Sommelier (using free template fallback for preview) =====
  const MOOD_TEMPLATES = {
    RELAXATION: [
      { oil: "Lavender", percent: 40 }, { oil: "Roman Chamomile", percent: 25 },
      { oil: "Bergamot", percent: 20 }, { oil: "Atlas Cedarwood", percent: 15 }
    ],
    STRESS: [
      { oil: "Lavender", percent: 30 }, { oil: "Bergamot", percent: 30 },
      { oil: "Frankincense", percent: 20 }, { oil: "Geranium", percent: 20 }
    ],
    ANXIETY: [
      { oil: "Lavender", percent: 35 }, { oil: "Bergamot", percent: 25 },
      { oil: "Neroli", percent: 20 }, { oil: "Frankincense", percent: 20 }
    ],
    INSOMNIA: [
      { oil: "Lavender", percent: 40 }, { oil: "Roman Chamomile", percent: 30 },
      { oil: "Atlas Cedarwood", percent: 20 }, { oil: "Vetiver", percent: 10 }
    ],
    FOCUS: [
      { oil: "Basil", percent: 30 }, { oil: "Rosemary", percent: 25 },
      { oil: "Peppermint", percent: 25 }, { oil: "Lemon", percent: 20 }
    ],
    ENERGY: [
      { oil: "Grapefruit", percent: 30 }, { oil: "Peppermint", percent: 25 },
      { oil: "Lemon", percent: 25 }, { oil: "Bergamot", percent: 20 }
    ],
    ROMANCE: [
      { oil: "Jasmine Sambac", percent: 30 }, { oil: "Ylang-Ylang", percent: 25 },
      { oil: "Damascena Rose", percent: 20 }, { oil: "Sandalwood", percent: 15 },
      { oil: "Bergamot", percent: 10 }
    ],
    MEDITATION: [
      { oil: "Frankincense", percent: 35 }, { oil: "Sandalwood", percent: 25 },
      { oil: "Myrrh", percent: 20 }, { oil: "Atlas Cedarwood", percent: 20 }
    ],
    HAPPINESS: [
      { oil: "Bergamot", percent: 30 }, { oil: "Sweet Orange", percent: 25 },
      { oil: "Ylang-Ylang", percent: 25 }, { oil: "Geranium", percent: 20 }
    ]
  };
  const NAMES = {
    RELAXATION: "Quietude", STRESS: "Soft Landing", ANXIETY: "Brave Heart",
    INSOMNIA: "Moonlit Calm", FATIGUE: "Bright Dawn", FOCUS: "Mindful Edge",
    ENERGY: "Solar Spark", ROMANCE: "Velvet Hour", MEDITATION: "Still Point",
    HAPPINESS: "Golden Bloom"
  };
  const MOOD_COLORS = {
    RELAXATION: "#A8DADC", STRESS: "#B5C9A4", ANXIETY: "#C8B8DB",
    INSOMNIA: "#4A5C8A", FOCUS: "#2A9D8F", ENERGY: "#E76F51",
    ROMANCE: "#D4A5A5", MEDITATION: "#6A4C93", HAPPINESS: "#F4D35E"
  };
  const STORIES = [
    "Imagine {o0} fields bathed in early morning light. This blend captures that exact moment of stillness, that breath between sleep and waking.",
    "Like walking through an ancient forest after rain, this combination brings depth, grounding, and a sense of return.",
    "A whisper of {o0} followed by warm {oLast} — the architecture of a feeling you already know."
  ];

  let selectedMood = null;
  let selectedOccasion = null;
  let selectedIntensity = "MEDIUM";
  let step = 1;

  const step1 = document.getElementById("step1");
  const step2 = document.getElementById("step2");
  const step3 = document.getElementById("step3");
  const result = document.getElementById("result");
  const nextBtn = document.getElementById("nextBtn");
  const backBtn = document.getElementById("backBtn");
  const stepIndicator = document.getElementById("stepIndicator");

  document.querySelectorAll(".mood-btn").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".mood-btn").forEach(x => { x.className = "mood-btn p-3 rounded-lg border border-ink-200 text-left hover:border-brand-500 hover:bg-brand-50/50 transition text-sm"; });
    b.className = "mood-btn p-3 rounded-lg border border-brand-500 bg-brand-50 text-brand-700 text-left text-sm font-medium";
    selectedMood = b.dataset.mood;
    nextBtn.disabled = false;
  }));
  document.querySelectorAll(".occasion-btn").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".occasion-btn").forEach(x => { x.className = "occasion-btn p-3 rounded-lg border border-ink-200 text-left hover:border-brand-500 hover:bg-brand-50/50 transition text-sm"; });
    b.className = "occasion-btn p-3 rounded-lg border border-brand-500 bg-brand-50 text-brand-700 text-left text-sm font-medium";
    selectedOccasion = b.dataset.occasion;
    nextBtn.disabled = false;
  }));
  document.querySelectorAll(".intensity-btn").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".intensity-btn").forEach(x => { x.className = "intensity-btn px-4 py-2 rounded-md border border-ink-200 text-sm hover:border-brand-300"; });
    b.className = "intensity-btn px-4 py-2 rounded-md border border-brand-500 bg-brand-50 text-brand-700 text-sm";
    selectedIntensity = b.dataset.intensity;
  }));

  nextBtn.addEventListener("click", () => {
    if (step === 1) { step = 2; step1.classList.add("hidden"); step2.classList.remove("hidden"); stepIndicator.textContent = "Step 2 of 3"; backBtn.classList.remove("hidden"); nextBtn.disabled = true; }
    else if (step === 2) { step = 3; step2.classList.add("hidden"); step3.classList.remove("hidden"); stepIndicator.textContent = "Step 3 of 3"; nextBtn.textContent = "✨ Craft My Blend"; }
    else if (step === 3) { generateBlend(); }
  });
  backBtn.addEventListener("click", () => {
    if (step === 2) { step = 1; step2.classList.add("hidden"); step1.classList.remove("hidden"); stepIndicator.textContent = "Step 1 of 3"; backBtn.classList.add("hidden"); nextBtn.disabled = false; nextBtn.textContent = "Next →"; }
    else if (step === 3) { step = 2; step3.classList.add("hidden"); step2.classList.remove("hidden"); stepIndicator.textContent = "Step 2 of 3"; nextBtn.disabled = false; nextBtn.textContent = "Next →"; }
  });

  function generateBlend() {
    const components = MOOD_TEMPLATES[selectedMood] || MOOD_TEMPLATES.RELAXATION;
    const name = NAMES[selectedMood] || "Personal Blend";
    const color = MOOD_COLORS[selectedMood] || "#6A4C93";
    const totalDrops = 200;
    const ingredients = components.map(c => ({ name: c.oil, amount: Math.round(c.percent/100 * totalDrops) }));
    const storyIdx = (Date.now() + selectedMood.length) % STORIES.length;
    const story = STORIES[storyIdx]
      .replace("{o0}", components[0].oil.toLowerCase())
      .replace("{oLast}", components[components.length-1].oil.toLowerCase());
    const dilutionMap = { LIGHT: "1% dilution. 2-3 drops in diffuser.", MEDIUM: "2-3% dilution. 4-5 drops in diffuser.", STRONG: "3-5% dilution. 5-7 drops in diffuser." };

    step1.classList.add("hidden"); step2.classList.add("hidden"); step3.classList.add("hidden");
    backBtn.classList.add("hidden");
    stepIndicator.parentElement.classList.add("hidden");
    result.classList.remove("hidden");
    result.innerHTML = `
      <div class="rounded-2xl p-6 mb-4 text-center relative overflow-hidden" style="background-color: ${color}10">
        <div class="absolute top-0 right-0 w-48 h-48 rounded-full blur-3xl opacity-30" style="background-color: ${color}"></div>
        <div class="relative">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/80 backdrop-blur border border-white/40 px-3 py-1 mb-3">
            <span>🧪</span><span class="text-xs font-medium">AI-Crafted</span>
          </div>
          <h3 class="font-display text-3xl md:text-4xl mb-2">${name}</h3>
          <p class="text-ink-700 max-w-md mx-auto">A blend tailored to your ${selectedMood.toLowerCase()} state and ${selectedOccasion.toLowerCase().replace(/_/g, " ")}.</p>
        </div>
      </div>
      <div class="card p-5 mb-4">
        <h4 class="font-display text-lg mb-2">The Story</h4>
        <p class="text-sm text-ink-700 italic leading-relaxed">${story}</p>
      </div>
      <div class="card p-5 mb-4">
        <h4 class="font-display text-lg mb-3">Recipe (10ml)</h4>
        ${ingredients.map((ing, i) => `
          <div class="mb-2.5">
            <div class="flex justify-between mb-1 text-sm">
              <span class="font-medium">${ing.name}</span>
              <span class="text-ink-500">${ing.amount} drops</span>
            </div>
            <div class="h-1.5 bg-ink-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full" style="width: ${(ing.amount/2)}%; background-color: ${color}"></div>
            </div>
          </div>
        `).join("")}
        <p class="text-xs text-ink-500 mt-3">Total: ${totalDrops} drops (10ml · ${selectedIntensity} intensity)</p>
      </div>
      <div class="card p-5 mb-4">
        <h4 class="font-display text-lg mb-2">How to use</h4>
        <p class="text-sm text-ink-600 mb-2">${dilutionMap[selectedIntensity]}</p>
        <p class="text-xs text-ink-500">⚠️ This is a static demo. The live AI Sommelier on the full site uses GPT-4o to generate truly personalized blends based on your unique input.</p>
      </div>
      <div class="card p-5 flex items-center justify-between">
        <div>
          <p class="text-sm text-ink-500">10ml Roller Bottle</p>
          <p class="font-display text-2xl">€24.00</p>
        </div>
        <button onclick="resetSommelier()" class="btn btn-secondary text-sm">← New blend</button>
      </div>
    `;
  }

  function resetSommelier() {
    step = 1;
    result.classList.add("hidden");
    result.innerHTML = "";
    step1.classList.remove("hidden");
    stepIndicator.parentElement.classList.remove("hidden");
    stepIndicator.textContent = "Step 1 of 3";
    nextBtn.textContent = "Next →";
    nextBtn.disabled = true;
    backBtn.classList.add("hidden");
    selectedMood = null;
    document.querySelectorAll(".mood-btn").forEach(x => { x.className = "mood-btn p-3 rounded-lg border border-ink-200 text-left hover:border-brand-500 hover:bg-brand-50/50 transition text-sm"; });
  }

  // ===== Ingredient catalog filter =====
  document.querySelectorAll(".cat-chip").forEach(chip => chip.addEventListener("click", () => {
    document.querySelectorAll(".cat-chip").forEach(x => { x.className = "cat-chip px-4 py-2 rounded-full bg-muted text-ink-700 text-sm font-medium hover:bg-ink-100"; });
    chip.className = "cat-chip px-4 py-2 rounded-full bg-brand-600 text-white text-sm font-medium";
    const cat = chip.dataset.cat;
    document.querySelectorAll(".ing-card").forEach(c => {
      c.style.display = (cat === "all" || c.dataset.cat === cat) ? "" : "none";
    });
  }));
</script>





